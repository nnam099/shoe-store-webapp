generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PREPARING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  logoUrl   String?  @map("logo_url") @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  products Product[]

  @@map("brands")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  productCategories ProductCategory[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  brandId     Int      @map("brand_id")
  name        String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(200)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  brand             Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  productCategories ProductCategory[]
  colorways         Colorway[]
  reviews           Review[]

  @@index([brandId])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

model ProductCategory {
  productId  Int @map("product_id")
  categoryId Int @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Colorway {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  name      String   @db.VarChar(100)
  slug      String   @db.VarChar(100)
  price     Decimal  @db.Decimal(12, 0)
  salePrice Decimal? @map("sale_price") @db.Decimal(12, 0)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product  Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  images   ProductImage[]
  variants Variant[]

  @@unique([productId, slug])
  @@map("colorways")
}

model ProductImage {
  id           Int      @id @default(autoincrement())
  colorwayId   Int      @map("colorway_id")
  imageUrl     String   @map("image_url") @db.VarChar(255)
  displayOrder Int      @default(1) @map("display_order") @db.SmallInt
  isThumbnail  Boolean  @default(false) @map("is_thumbnail")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  colorway Colorway @relation(fields: [colorwayId], references: [id], onDelete: Cascade)

  @@unique([colorwayId, displayOrder])
  @@map("product_images")
}

model Variant {
  id         Int      @id @default(autoincrement())
  colorwayId Int      @map("colorway_id")
  size       String   @db.VarChar(10)
  stock      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  colorway   Colorway    @relation(fields: [colorwayId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([colorwayId, size])
  @@map("variants")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(100)
  phone        String   @db.VarChar(20)
  address      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  orders  Order[]
  reviews Review[]

  @@map("users")
}

model AdminAccount {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("admin_accounts")
}

model Order {
  id              Int         @id @default(autoincrement())
  orderCode       String      @unique @map("order_code") @db.VarChar(50)
  userId          Int?        @map("user_id")
  status          OrderStatus @default(PENDING)
  paymentMethod   String      @default("COD") @map("payment_method") @db.VarChar(20)
  receiverName    String      @map("receiver_name") @db.VarChar(100)
  receiverPhone   String      @map("receiver_phone") @db.VarChar(20)
  receiverAddress String      @map("receiver_address") @db.Text
  note            String?     @db.Text
  subtotal        Decimal     @db.Decimal(12, 0)
  shippingFee     Decimal     @map("shipping_fee") @db.Decimal(12, 0)
  total           Decimal     @db.Decimal(12, 0)
  stockRestoredAt DateTime?   @map("stock_restored_at") @db.Timestamptz
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user            User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItems      OrderItem[]
  statusHistories OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([completedAt])
  @@map("orders")
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  orderId       Int     @map("order_id")
  variantId     Int     @map("variant_id")
  productName   String  @map("product_name") @db.VarChar(200)
  colorwayName  String  @map("colorway_name") @db.VarChar(100)
  size          String  @db.VarChar(10)
  unitPrice     Decimal @map("unit_price") @db.Decimal(12, 0)
  quantity      Int
  colorwayImage String? @map("colorway_image") @db.VarChar(255)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int         @map("order_id")
  status    OrderStatus
  changedAt DateTime    @default(now()) @map("changed_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, changedAt])
  @@map("order_status_histories")
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  userId    Int      @map("user_id")
  rating    Int      @db.SmallInt
  comment   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([productId, userId])
  @@map("reviews")
}
