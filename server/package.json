{
  "name": "shoe-store-server",
  "version": "1.0.0",
  "description": "Backend REST API for shoe store web application",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "bootstrap-admin": "node prisma/bootstrap-admin.js",
    "seed": "node prisma/seed.js",
    "db:test:prepare": "node prisma/prepare-test-database.js",
    "db:test:seed": "node prisma/prepare-test-database.js --seed",
    "test": "node --import ./test/setupTestEnv.js --test --test-concurrency=1",
    "test:unit": "node --test --test-concurrency=1 test/*.unit.test.js",
    "test:integration": "node --import ./test/setupTestEnv.js --test --test-concurrency=1 test/*.integration.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.10",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^7.10.0"
  }
}
