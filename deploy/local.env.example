# Copy this file to deploy/.env and replace every REPLACE_WITH_* value.
# deploy/.env is ignored by Git. Do not commit it.
COMPOSE_PROJECT_NAME=steplab-local

POSTGRES_DB=steplab_local
POSTGRES_USER=steplab_app
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
# URL-encode the password when it contains reserved URL characters.
DATABASE_URL=postgresql://steplab_app:REPLACE_WITH_URL_ENCODED_LOCAL_DATABASE_PASSWORD@db:5432/steplab_local?schema=public

HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80
APP_BASE_URL=http://localhost:8080
TRUST_PROXY_HOPS=1

JWT_MEMBER_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_MEMBER_EXPIRES_IN=8h
JWT_ADMIN_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET
JWT_ADMIN_EXPIRES_IN=8h
OTP_HMAC_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET
SECURITY_HASH_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET

VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# SMTP may remain blank for local health/proxy checks. Email features will fail closed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=STEP/LAB
MAIL_FROM_ADDRESS=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
EMAIL_WORKER_INTERVAL_MS=10000
EMAIL_WORKER_BATCH_SIZE=20

SHIPPING_FEE=30000
