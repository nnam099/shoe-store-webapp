# Copy this file to deploy/.env on the server and replace every placeholder.
# Never commit deploy/.env or send its contents through chat.
COMPOSE_PROJECT_NAME=steplab-production

POSTGRES_DB=steplab_prod
POSTGRES_USER=steplab_app
POSTGRES_PASSWORD=REPLACE_WITH_PRODUCTION_DATABASE_PASSWORD
# URL-encode the password when it contains reserved URL characters.
DATABASE_URL=postgresql://steplab_app:REPLACE_WITH_URL_ENCODED_PRODUCTION_DATABASE_PASSWORD@db:5432/steplab_prod?schema=public

HTTP_PORT=80
HTTPS_PORT=443
SITE_ADDRESS=shop.example.com
APP_BASE_URL=https://shop.example.com
TRUST_PROXY_HOPS=1

JWT_MEMBER_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_MEMBER_EXPIRES_IN=8h
JWT_ADMIN_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET
JWT_ADMIN_EXPIRES_IN=8h
OTP_HMAC_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET
SECURITY_HASH_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET

VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_PUBLIC_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_ID=REPLACE_WITH_THE_SAME_PUBLIC_GOOGLE_WEB_CLIENT_ID

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_GMAIL_ADDRESS
SMTP_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD
MAIL_FROM_NAME=STEP/LAB
MAIL_FROM_ADDRESS=REPLACE_WITH_APPROVED_SENDER_ADDRESS
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
EMAIL_WORKER_INTERVAL_MS=10000
EMAIL_WORKER_BATCH_SIZE=20

SHIPPING_FEE=30000
