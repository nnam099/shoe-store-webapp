{
  "name": "shoe-store-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "test": "vitest run",
    "test:integration": "node scripts/prepare-test-database.js && vitest run tests/integration/schema.test.js",
    "test:seed": "node scripts/prepare-test-database.js && vitest run tests/integration/seed.test.js",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "migrate": "node-pg-migrate up --migrations-dir migrations --migration-file-language js",
    "seed": "node --env-file-if-exists=../.env seeds/seed.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.2.2",
    "vitest": "^5.0.1"
  }
}
